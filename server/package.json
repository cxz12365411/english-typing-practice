{
  "name": "english-typing-practice-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:migrate": "node dist/scripts/migrate.js",
    "admin:bootstrap": "node dist/scripts/bootstrap-admin.js",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "argon2": "^0.45.0",
    "better-sqlite3": "^12.4.1",
    "csv-parse": "^6.1.0",
    "fastify": "^5.7.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
