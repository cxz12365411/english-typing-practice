# This file uses simple, unquoted systemd EnvironmentFile key=value records.
# Keep it owned by root:englishapp with mode 0640.
NODE_ENV=production
HOST=127.0.0.1
PORT=8091
DATABASE_PATH=/var/lib/english-typing-practice/app.db
APP_ORIGIN=https://english-47-120-37-63.sslip.io
TRUST_PROXY=loopback
GUEST_TOKEN_SECRET=__GENERATED_BY_PROVISION_HOST__

# Email verification is fail-closed until a real SMTP account is configured.
# provision-host.sh replaces both secret placeholders with independent random values.
EMAIL_DELIVERY=disabled
EMAIL_CODE_SECRET=__GENERATED_BY_PROVISION_HOST__
EMAIL_SELF_REGISTRATION=false
EMAIL_DAILY_SEND_LIMIT=180
EMAIL_REGISTRATION_DAILY_SEND_LIMIT=20
EMAIL_REGISTRATION_IP_DAILY_LIMIT=10

# SMTP is used only when EMAIL_DELIVERY=smtp. Keep this file root:englishapp 0640,
# edit it with sudoedit, and never put SMTP_PASSWORD in a shell command or Git.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=英语打字练习
