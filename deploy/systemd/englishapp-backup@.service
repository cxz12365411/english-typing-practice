[Unit]
Description=English Typing Practice SQLite %i backup
Documentation=file:/usr/local/share/english-typing-practice/README.md
ConditionPathExists=/var/lib/english-typing-practice/app.db

[Service]
Type=oneshot
User=englishapp
Group=englishapp
ExecStart=/usr/local/libexec/english-typing-practice/backup-sqlite.sh %i
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/english-typing-practice /var/backups/english-typing-practice /var/lib/english-typing-practice-locks/database.lock
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=128M
TasksMax=32
